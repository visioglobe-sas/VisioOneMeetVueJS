# Map hash from https://my.visioglobe.com (the map must be "built")
VITE_VISIOONE_HASH=your-map-hash-here

# Optional: server hosting the map data. Defaults to https://mapserver.visioglobe.com/
# VITE_VISIOONE_BASE_URL=

# Optional: JWT bearer token, required when baseURL supports authorization
# VITE_VISIOONE_AUTH_TOKEN=
